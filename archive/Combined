#include "Arduino_BMI270_BMM150.h"
#include <math.h>
#include <Arduino.h>

// Motor Driver Pins
const int Ain1 = 2;
const int Ain2 = 3;
const int Bin2 = 4;
const int Bin1 = 5;

// Ultrasonic Sensor Pins
const int trigPin1 = 9;
const int echoPin1 = 10;
const int trigPin2 = 8;
const int echoPin2 = 7;
const int speakerPin = 13;

// PID Gains
float Kp = 6.2;
float Ki = 29.2;
float Kd = 0.33;

// PID Parameters
float desiredAngle = -0.2;
float integral = 0.0;
float lastDerivative = 0.0;
float prevError = 0.0;
unsigned long prevTime = 0;

// Complementary Filter Parameters
float Kw = 0.99;
float filteredAngle;
float gyroAngle = 0.0;
float gyroBias = 0.0;

// Sonar Parameters
const int moduleFrequency = 1000;
unsigned long previousBeepTime = 0;
int beepInterval = 500;

void setup() {
    Serial.begin(9600);
    while (!Serial);
    Serial.println("Started");

    if (!IMU.begin()) {
        Serial.println("Failed to initialize IMU!");
        while (1);
    }

    // Gyroscope Calibration
    float x, y, z;
    int samples = 0;
    while (samples < 1000) {
        if (IMU.gyroscopeAvailable()) {
            IMU.readGyroscope(x, y, z);
            gyroBias += x;
            samples++;
        }
    }
    gyroBias /= samples;

    pinMode(Ain1, OUTPUT);
    pinMode(Ain2, OUTPUT);
    pinMode(Bin1, OUTPUT);
    pinMode(Bin2, OUTPUT);
    pinMode(trigPin1, OUTPUT);
    pinMode(echoPin1, INPUT);
    pinMode(trigPin2, OUTPUT);
    pinMode(echoPin2, INPUT);
    pinMode(speakerPin, OUTPUT);

    prevTime = micros();
}

float getDistance(int trigPin, int echoPin) {
    digitalWrite(trigPin, LOW);
    delayMicroseconds(2);
    digitalWrite(trigPin, HIGH);
    delayMicroseconds(10);
    digitalWrite(trigPin, LOW);
    return (pulseIn(echoPin, HIGH) * 0.0343) / 2;
}

void loop() {
    unsigned long currentTime = micros();
    float dt = (currentTime - prevTime) / 1E6;
    prevTime = currentTime;

    // Read IMU Data
    float ax, ay, az, gx, gy, gz;
    if (IMU.accelerationAvailable() && IMU.gyroscopeAvailable()) {
        IMU.readAcceleration(ax, ay, az);
        IMU.readGyroscope(gx, gy, gz);
    } else {
        Serial.println("IMU error");
        return;
    }

    // Tilt Calculation
    gx -= gyroBias;
    float gyroChange = gx * dt;
    gyroAngle += gyroChange;
    float accelAngle = -atan2(ay, az) * (180.0 / PI);
    filteredAngle = Kw * (filteredAngle + gyroChange) + (1 - Kw) * accelAngle;

    // PID Control
    float currentError = desiredAngle - filteredAngle;
    float proportional = Kp * currentError;
    integral += currentError * dt;
    integral = constrain(integral, -50.0, 50.0);
    float derivative = (currentError - prevError) / dt;
    derivative = 0.8 * derivative + 0.2 * lastDerivative;
    lastDerivative = derivative;
    prevError = currentError;

    float PIDoutput = proportional + (Ki * integral) + (Kd * derivative);
    float pwm = (abs(currentError) < 1.0) ? 0 : constrain(abs(PIDoutput), 0, 255);
    driveMotorsSD(PIDoutput < 0 ? pwm : -pwm, PIDoutput < 0 ? pwm : -pwm);

    // Sonar Distance Reading
    float distance1 = getDistance(trigPin1, echoPin1);
    float distance2 = getDistance(trigPin2, echoPin2);
    float minDistance = min(distance1, distance2);
    beepInterval = constrain(map((int)minDistance, 5, 100, 100, 1000), 100, 1000);

    if (millis() - previousBeepTime >= beepInterval) {
        previousBeepTime = millis();
        tone(speakerPin, moduleFrequency, 100);
    }

    // Debugging Output
    Serial.print("Angle: "); Serial.print(filteredAngle);
    Serial.print(" | PWM: "); Serial.print(pwm);
    Serial.print(" | Dist1: "); Serial.print(distance1);
    Serial.print(" | Dist2: "); Serial.println(distance2);
}

void driveMotorsSD(int speedL, int speedR) {
    if (speedL > 0) {
        analogWrite(Ain1, 1);
        analogWrite(Ain2, speedL);
    } else {
        analogWrite(Ain1, abs(speedL));
        analogWrite(Ain2, 1);
    }

    if (speedR > 0) {
        analogWrite(Bin1, 1);
        analogWrite(Bin2, speedR);
    } else {
        analogWrite(Bin1, abs(speedR));
        analogWrite(Bin2, 1);
    }
}
